<classic:ClassicWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Classic.CommonControls;assembly=Classic.CommonControls.Avalonia"
    xmlns:notepad="clr-namespace:Notepad"
    xmlns:classic="clr-namespace:Classic.Avalonia.Theme;assembly=Classic.Avalonia.Theme"
    x:Class="Notepad.MainWindow" x:DataType="notepad:NotepadViewModel"
    Icon="icon.png" Width="720" Height="540" MinWidth="420" MinHeight="280"
    Title="{Binding Title}">
  <DockPanel>
    <Menu DockPanel.Dock="Top" x:Name="MainMenu">
      <MenuItem Header="_File">
        <MenuItem Header="_New" InputGesture="Ctrl+N" Tag="New" Click="MenuClick" />
        <MenuItem Header="_Open..." InputGesture="Ctrl+O" Tag="Open" Click="MenuClick" />
        <MenuItem Header="_Save" InputGesture="Ctrl+S" Tag="Save" Click="MenuClick" />
        <MenuItem Header="Save _As..." InputGesture="Ctrl+Shift+S" Tag="SaveAs" Click="MenuClick" />
        <Separator />
        <MenuItem Header="Page Set_up..." Tag="PageSetup" Click="MenuClick" />
        <MenuItem Header="_Print..." InputGesture="Ctrl+P" Tag="Print" Click="MenuClick" />
        <Separator />
        <MenuItem Header="E_xit" Tag="Exit" Click="MenuClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Tag="Undo" Click="MenuClick" IsEnabled="{Binding #Editor.CanUndo}" />
        <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Tag="Redo" Click="MenuClick" IsEnabled="{Binding #Editor.CanRedo}" />
        <Separator />
        <MenuItem Header="Cu_t" InputGesture="Ctrl+X" Tag="Cut" Click="MenuClick" IsEnabled="{Binding #Editor.CanCut}" />
        <MenuItem Header="_Copy" InputGesture="Ctrl+C" Tag="Copy" Click="MenuClick" IsEnabled="{Binding #Editor.CanCopy}" />
        <MenuItem Header="_Paste" InputGesture="Ctrl+V" Tag="Paste" Click="MenuClick" IsEnabled="{Binding #Editor.CanPaste}" />
        <MenuItem Header="_Delete" InputGesture="Delete" Tag="Delete" Click="MenuClick" IsEnabled="{Binding #Editor.CanCut}" />
        <Separator />
        <MenuItem Header="_Find..." InputGesture="Ctrl+F" Tag="Find" Click="MenuClick" />
        <MenuItem Header="Find _Next" InputGesture="F3" Tag="FindNext" Click="MenuClick" />
        <MenuItem Header="Find Previous" InputGesture="Shift+F3" Tag="FindPrevious" Click="MenuClick" />
        <MenuItem Header="_Replace..." InputGesture="Ctrl+H" Tag="Replace" Click="MenuClick" />
        <MenuItem Header="_Go To..." InputGesture="Ctrl+G" Tag="GoTo" Click="MenuClick" />
        <Separator />
        <MenuItem Header="Select _All" InputGesture="Ctrl+A" Tag="SelectAll" Click="MenuClick" />
        <MenuItem Header="Time/_Date" InputGesture="F5" Tag="DateTime" Click="MenuClick" />
      </MenuItem>
      <MenuItem Header="F_ormat">
        <MenuItem Header="_Word Wrap" x:Name="WordWrapMenu" ToggleType="CheckBox" Tag="WordWrap" Click="MenuClick" />
        <MenuItem Header="_Font..." Tag="Font" Click="MenuClick" />
        <MenuItem Header="_Encoding">
          <MenuItem Header="UTF-8" Tag="Encoding:Utf8" Click="MenuClick" />
          <MenuItem Header="UTF-8 with BOM" Tag="Encoding:Utf8Bom" Click="MenuClick" />
          <MenuItem Header="UTF-16 LE" Tag="Encoding:Utf16LittleEndian" Click="MenuClick" />
          <MenuItem Header="UTF-16 BE" Tag="Encoding:Utf16BigEndian" Click="MenuClick" />
          <MenuItem Header="GB18030" Tag="Encoding:Gb18030" Click="MenuClick" />
          <MenuItem Header="Western (Windows-1252)" Tag="Encoding:Western1252" Click="MenuClick" />
          <MenuItem Header="System ANSI" Tag="Encoding:SystemAnsi" Click="MenuClick" />
        </MenuItem>
        <MenuItem Header="Line _Endings">
          <MenuItem Header="Windows (CRLF)" Tag="NewLine:CRLF" Click="MenuClick" />
          <MenuItem Header="Unix (LF)" Tag="NewLine:LF" Click="MenuClick" />
          <MenuItem Header="Classic Mac (CR)" Tag="NewLine:CR" Click="MenuClick" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Status Bar" x:Name="StatusBarMenu" ToggleType="CheckBox" IsChecked="True" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="Help _Topics" Tag="Help" Click="MenuClick" />
        <Separator />
        <MenuItem Header="_About Notepad" Tag="About" Click="MenuClick" />
      </MenuItem>
    </Menu>
    <common:StatusBar DockPanel.Dock="Bottom" IsVisible="{Binding #StatusBarMenu.IsChecked}">
      <common:StatusBarItem common:StatusBar.Size="10*" Content="{Binding FileStatus}" />
      <common:StatusBarItem Content="{Binding Position}" />
    </common:StatusBar>
    <TextBox x:Name="Editor" Text="{Binding Text, Mode=TwoWay}"
             AcceptsReturn="True" AcceptsTab="True" IsUndoEnabled="True"
             FontFamily="{Binding Font}" FontSize="{Binding FontSize}"
             FontStyle="{Binding FontStyle}" FontWeight="{Binding FontWeight}"
             TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</classic:ClassicWindow>
